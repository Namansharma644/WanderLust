<%- layout("/layouts/boilerplate") %>
<% const hasSearchFilters = Boolean(filters.q || filters.minPrice !== undefined || filters.maxPrice !== undefined || filters.sort !== 'default'); %>

<section class="wl-hero" aria-labelledby="hero-title">
  <div class="wl-hero-copy">
    <p class="wl-eyebrow">
      <span class="wl-eyebrow-line"> </span> FOR THE LOVE OF GETTING AWAY
    </p>
    <h1 class="wl-hero-title" id="hero-title">
      Somewhere new.<br />
      <em>Something you.</em>
    </h1>
    <p class="wl-hero-subtitle">
      Slow mornings. New horizons. A place that feels like you.<br
        class="wl-desktop-break"
      />
      Find a stay worth the journey.
    </p>
    <form class="wl-hero-search" role="search" method="get" action="/listings">
      <span class="wl-search-pin">
        <%- include("../includes/icon", { name: "pin" }) %>
      </span>
      <div class="wl-hero-search-field">
        <label for="hero-search">Your next destination</label>
        <input
          id="hero-search"
          type="search"
          name="q"
          value="<%= filters.q %>"
          maxlength="100"
          placeholder="City, country, or a place you love"
          aria-label="Search listings"
          autocomplete="off"
        />
      </div>
      <% if(filters.minPrice !== undefined){ %>
      <input type="hidden" name="minPrice" value="<%= filters.minPrice %>" />
      <% } %> <% if(filters.maxPrice !== undefined){ %>
      <input type="hidden" name="maxPrice" value="<%= filters.maxPrice %>" />
      <% } %> <% if(filters.sort !== 'default'){ %>
      <input type="hidden" name="sort" value="<%= filters.sort %>" />
      <% } %>
      <button
        class="wl-hero-search-btn"
        type="submit"
        aria-label="Explore stays"
      >
        <span>Explore</span>
        <%- include("../includes/icon", { name: "arrow" }) %>
      </button>
    </form>
    <a class="wl-hero-browse" href="#stays"
      >Or take a look around <span aria-hidden="true">↘</span>
    </a>
  </div>
  <div class="wl-hero-art">
    <div class="wl-postcard">
      <img
        src="/images/escape-illustration.svg"
        width="1000"
        height="1100"
        alt="Illustration of a coastal hideaway, winding paths and mountains"
        fetchpriority="high"
      />
      <div class="wl-postcard-caption">
        <span>A CHANGE OF SCENERY</span>
        <span>does a world of good.</span>
      </div>
    </div>
    <div class="wl-journey-stamp" aria-hidden="true">
      <%- include("../includes/icon", { name: "sun" }) %>
      <span>GO A LITTLE<br />OFF THE MAP</span>
    </div>
    <div class="wl-hero-note">
      <span aria-hidden="true">↗</span> Your next chapter starts somewhere.
    </div>
  </div>
</section>

<section class="wl-discovery" id="stays" aria-labelledby="stays-title">
  <div class="wl-section-heading">
    <div>
      <p class="wl-eyebrow">FIND YOUR KIND OF GETAWAY</p>
      <h2 id="stays-title">
        <%= hasSearchFilters ? 'Your next stay, a little closer.' : 'Places to pause. Places to explore.' %>
      </h2>
    </div>
    <p class="wl-results-count" role="status">
      <strong>
        <%= pagination.total %>
      </strong>
      <%= pagination.total === 1 ? 'stay' : 'stays' %>
      <%= hasSearchFilters ? 'found' : 'to discover' %>
    </p>
  </div>
  <form
    class="wl-search-filters"
    method="get"
    action="/listings"
    aria-label="Filter listings by nightly price"
  >
    <input type="hidden" name="q" value="<%= filters.q %>" />
    <div class="wl-filter-heading">
      <%- include("../includes/icon", { name: "sliders" }) %>
      <span>Make it your stay</span>
    </div>
    <div class="wl-filter-field">
      <label for="minPrice" class="wl-form-label">Min price · ₹ / night</label>
      <input
        id="minPrice"
        name="minPrice"
        class="wl-form-input"
        type="number"
        min="0"
        max="100000000"
        step="any"
        placeholder="Any minimum"
        value="<%= filters.minPrice === undefined ? '' : filters.minPrice %>"
      />
    </div>
    <div class="wl-filter-field">
      <label for="maxPrice" class="wl-form-label">Max price · ₹ / night</label>
      <input
        id="maxPrice"
        name="maxPrice"
        class="wl-form-input"
        type="number"
        min="0"
        max="100000000"
        step="any"
        placeholder="Any maximum"
        value="<%= filters.maxPrice === undefined ? '' : filters.maxPrice %>"
      />
    </div>
    <div class="wl-filter-field">
      <label for="sort" class="wl-form-label">Sort your stays</label>
      <select id="sort" name="sort" class="wl-form-input">
        <option value="default" <%= filters.sort === 'default' ? 'selected' : '' %>>Default order</option>
        <option value="price_asc" <%= filters.sort === 'price_asc' ? 'selected' : '' %>>
          Price: low to high
        </option>
        <option value="price_desc" <%= filters.sort === 'price_desc' ? 'selected' : '' %>>
          Price: high to low
        </option>
      </select>
    </div>
    <button class="wl-btn wl-btn-primary" type="submit">
      Apply filters <%- include("../includes/icon", { name: "arrow" }) %>
    </button>
    <% if(hasSearchFilters){ %>
    <a class="wl-clear-filters" href="/listings">Clear filters</a>
    <% } %>
  </form>
  <div class="wl-results-toolbar">
    <p>
      <% if(filters.q){ %>Exploring “<strong>
        <%= filters.q %> </strong
      >”<% } else { %>A different view. A fresh perspective.<% } %>
    </p>
    <div class="wl-tax-toggle form-check form-switch">
      <input
        class="form-check-input"
        type="checkbox"
        role="switch"
        id="taxSwitch"
      />
      <label class="form-check-label" for="taxSwitch"
        >Show tax information</label
      >
    </div>
  </div>
  <% if(allListing && allListing.length > 0){ %>
  <div class="wl-listings-grid">
    <% for(let listing of allListing){ %>
    <%- include('../includes/listingCard', { listing }) %>
    <% } %>
  </div>
  <%- include('../includes/pagination', { pagination }) %>
  <% } else { %>
  <div class="wl-empty-state">
    <span class="wl-state-icon">
      <%- include("../includes/icon", { name: hasSearchFilters ? 'search' : 'compass' }) %>
    </span>
    <h3>
      <%= hasSearchFilters ? 'No listings found' : 'Every journey starts somewhere.' %>
    </h3>
    <p>
      <%= hasSearchFilters ? 'A small change could open up a whole new place. Try another destination or a wider price range.' : 'There are no stays listed yet. Share your space and be part of the first chapter.' %>
    </p>
    <% if(hasSearchFilters){ %>
    <a href="/listings" class="wl-btn wl-btn-primary">Clear filters</a>
    <% } else { %>
    <a
      href="<%= currUser ? '/listings/new' : '/login' %>"
      class="wl-btn wl-btn-primary"
    >
      <%= currUser ? 'Create first listing' : 'Log in to share your space' %>
    </a>
    <% } %>
  </div>
  <% } %>
</section>
<section class="wl-host-banner" aria-labelledby="host-title">
  <div>
    <p class="wl-eyebrow">THERE'S A STORY IN EVERY SPACE</p>
    <h2 id="host-title">
      Yours could be someone's<br />
      <em>favourite place.</em>
    </h2>
    <p>Open your door to a new kind of traveller.</p>
  </div>
  <a href="/listings/new" class="wl-btn wl-btn-primary"
    >Share your space <%- include("../includes/icon", { name: "arrow" }) %>
  </a>
  <span class="wl-host-decoration" aria-hidden="true">
    <%- include("../includes/icon", { name: "home" }) %>
  </span>
</section>
