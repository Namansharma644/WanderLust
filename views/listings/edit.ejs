<%- layout("/layouts/boilerplate") %>

<div class="wl-listing-form-container">
  <a href="/listings/<%= listing._id %>" class="wl-back-link">
    <%- include("../includes/icon", { name: "back" }) %> Back to listing
  </a>

  <div class="wl-form-card">
    <div class="wl-form-header wl-listing-form-header">
      <p class="wl-eyebrow">A LITTLE ATTENTION TO DETAIL</p>
      <h1>Edit Listing</h1>
      <p>
        Keep your space looking its best. Update the details travellers need for
        their next getaway.
      </p>
      <span class="wl-form-required-note">Fields marked * are required.</span>
    </div>

    <form
      method="post"
      action="/listings/<%= listing._id %>/?_method=PUT"
      novalidate
      class="needs-validation"
      enctype="multipart/form-data"
    >
      <div class="wl-form-group">
        <label for="title" class="wl-form-label"
          >Property Title <span style="color: var(--color-accent)">*</span>
        </label>
        <input
          name="listing[title]"
          type="text"
          class="wl-form-input"
          id="title"
          value="<%= listing.title %>"
          required
        />
        <div class="valid-feedback">Looks good!</div>
        <div class="invalid-feedback">Please enter a valid title.</div>
      </div>

      <div class="wl-form-group">
        <label for="description" class="wl-form-label"
          >Description <span aria-hidden="true">*</span>
        </label>
        <textarea
          name="listing[description]"
          class="wl-form-input"
          id="description"
          rows="5"
          required
        >
<%= listing.description %>
</textarea
        >
        <div class="invalid-feedback">Please add a short description.</div>
      </div>

      <!-- Current image preview -->
      <div class="wl-form-group">
        <p class="wl-form-label">Current Photo</p>
        <div>
          <img
            class="wl-form-image-preview"
            src="<%= originalImgUrl %>"
            alt="Current photo of <%= listing.title %>"
            data-listing-photo
          />
        </div>
      </div>

      <div class="wl-form-group">
        <label for="image" class="wl-form-label"
          >Replace Photo
          <span
            style="
              font-size: var(--font-size-xs);
              color: var(--color-text-muted);
              font-weight: 400;
            "
            >(optional)</span
          >
        </label>
        <input
          name="listing[image][url]"
          type="file"
          class="wl-form-input"
          id="image"
          accept="image/*"
          aria-describedby="image-help"
        />
        <div class="wl-form-hint" id="image-help">
          Leave blank to keep the current photo.
        </div>
      </div>

      <div class="wl-selected-photo" hidden>
        <img
          id="selected-photo"
          alt="Preview of your selected property photo"
        />
        <p class="wl-form-hint">Selected photo preview</p>
      </div>

      <div class="wl-form-row">
        <div class="wl-form-group" style="margin-bottom: 0">
          <label for="price" class="wl-form-label"
            >Price per night (&#8377;)
            <span style="color: var(--color-accent)">*</span>
          </label>
          <input
            name="listing[price]"
            type="number"
            class="wl-form-input"
            id="price"
            value="<%= listing.price %>"
            min="1"
            required
          />
          <div class="invalid-feedback">Please enter a valid price.</div>
        </div>

        <div class="wl-form-group" style="margin-bottom: 0">
          <label for="country" class="wl-form-label"
            >Country <span style="color: var(--color-accent)">*</span>
          </label>
          <input
            name="listing[country]"
            type="text"
            class="wl-form-input"
            id="country"
            value="<%= listing.country %>"
            required
          />
          <div class="invalid-feedback">Please enter a valid country.</div>
        </div>
      </div>

      <div class="wl-form-group" style="margin-top: var(--space-lg)">
        <label for="location" class="wl-form-label"
          >Location / City <span style="color: var(--color-accent)">*</span>
        </label>
        <input
          name="listing[location]"
          type="text"
          class="wl-form-input"
          id="location"
          value="<%= listing.location %>"
          required
        />
        <div class="invalid-feedback">Please enter a valid location.</div>
      </div>

      <div class="wl-form-footer">
        <a class="wl-form-cancel" href="/listings/<%= listing._id %>">Cancel</a>
        <button class="wl-btn wl-btn-primary wl-btn-lg" type="submit">
          <%- include("../includes/icon", { name: "check" }) %> Save Changes
        </button>
      </div>
    </form>
  </div>
</div>
