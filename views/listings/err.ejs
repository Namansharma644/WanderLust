<%- layout("/layouts/boilerplate") %>
<div class="wl-error-container">
  <span class="wl-state-icon">
    <%- include("../includes/icon", { name: "compass" }) %>
  </span>
  <p class="wl-eyebrow">A SMALL DETOUR</p>
  <h1 class="wl-error-title">
    <%= err.statusCode === 404 ? 'This path leads somewhere else.' : err.statusCode === 400 ? 'Let’s check those details.' : 'A pause in the journey.' %>
  </h1>
  <p class="wl-error-message"><%= err.message %></p>
  <a href="/listings" class="wl-btn wl-btn-primary"
    >Back to exploring <%- include("../includes/icon", { name: "arrow" }) %>
  </a>
</div>
