<footer class="wl-footer">
  <div class="wl-footer-inner">
    <div>
      <a href="/listings" class="wl-brand wl-footer-logo">
        <span class="wl-brand-mark">
          <%- include("icon", { name: "compass" }) %>
        </span>
        <span>WanderLust<span class="wl-brand-dot">.</span> </span>
      </a>
      <p class="wl-footer-tagline">A little further from ordinary.</p>
