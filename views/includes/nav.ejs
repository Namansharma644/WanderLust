    <a class="wl-brand navbar-brand" href="/listings">
      <i class="fa-regular fa-compass"></i>
      <span>WanderLust</span>
    </a>

    <!-- Mobile Toggle -->
    <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#wlNavbar"
      aria-controls="wlNavbar" aria-expanded="false" aria-label="Toggle navigation">
      <span class="navbar-toggler-icon"></span>
    </button>

    <div class="collapse navbar-collapse" id="wlNavbar">

      <!-- Centre search -->
      <div class="mx-auto my-2 my-lg-0">
        <form class="wl-nav-search" role="search" method="get" action="/listings">
          <i class="fa-solid fa-magnifying-glass" style="color:var(--color-text-muted); font-size:0.85rem; flex-shrink:0;"></i>
          <input type="search" name="q" placeholder="Search destinations…" aria-label="Search destinations" autocomplete="off">
          <button class="wl-nav-search-btn" type="submit" aria-label="Search">
            <i class="fa-solid fa-magnifying-glass"></i>
          </button>
        </form>
      </div>

      <!-- Right-side links -->
      <div class="wl-nav-links wl-nav-auth ms-lg-3">
