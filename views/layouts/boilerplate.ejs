<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#a94e3b" />
    <meta
      name="description"
      content="Find a place worth going somewhere for. Explore homes, cabins and memorable stays with WanderLust."
    />
    <title>WanderLust — A stay worth the journey</title>
    <link rel="icon" href="/images/favicon.svg" type="image/svg+xml" />
    <link
      rel="preload"
      href="/fonts/plus-jakarta-sans.ttf"
      as="font"
      type="font/ttf"
      crossorigin
    />
    <link
      href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css"
      rel="stylesheet"
      integrity="sha384-sRIl4kxILFvY47J16cr9ZwB07vP4J8+LH7qKQnuqkuIAvNWLzeN8tE5YBujZqJLB"
      crossorigin="anonymous"
    />
    <link href="/css/rating.css" rel="stylesheet" />
    <link href="/css/style.css" rel="stylesheet" />
  </head>
  <body>
    <a class="wl-skip-link" href="#main-content">Skip to content</a>
    <%- include("../includes/nav.ejs") %>
    <main class="main-content" id="main-content" tabindex="-1">
      <div class="wl-page-container">
        <%- include("../includes/flash.ejs") %>
        <p class="wl-save-status" data-save-status role="status" hidden></p>
        <%- body %>
      </div>
    </main>
    <%- include("../includes/footer.ejs") %>
    <script
      src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js"
      integrity="sha384-FKyoEForCGlyvwx9Hj09JcYn3nv7wiPVlz7YYwJrWVcXK/BmnVDxM+D2scQbITxI"
      crossorigin="anonymous"
    ></script>
    <script src="/js/script.js"></script>
    <script src="/js/saved-stays.js"></script>
  </body>
</html>
